{
  "name": "svg-cli-editor",
  "version": "0.1.0",
  "private": true,
  "description": "PJ1 Phase 1 object-oriented SVG command-line editor",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-plugin-manifests.cjs",
    "cli": "npm run build --silent && node dist/src/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "test:stats": "npm run build --silent && node --test dist/test/stats.test.js",
    "test:dir": "npm run build --silent && node --test dist/test/dir.test.js",
    "test:box": "npm run build --silent && node --test dist/test/box.test.js",
    "test:star": "npm run build --silent && node --test dist/test/modified-star.test.js",
    "check": "npm test && node scripts/check-architecture.cjs",
    "check:baseline": "node scripts/check-baseline.cjs",
    "metrics": "node scripts/generate-metrics.cjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "fast-xml-parser": "^5.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.0.0" }
}
